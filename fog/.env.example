# Copiar a .env (no se sube a git) y completar.

# --- Backend ---
BACKEND_URL=https://fulltank-backend.onrender.com/api
DEVICE_TOKEN=
FOG_API_KEY=

# --- Broker MQTT (HiveMQ público, complemento) ---
# Sin usuario ni clave: no envíes credenciales a un tercero.
MQTT_URL=tcp://broker.hivemq.com:1883
MQTT_TOPIC=fulltank/cambia-este-sufijo/tanks/+/readings

# --- Política ---
ALLOWED_DEVICE_IDS=
MAX_LEVEL=100000
