# Copiar a .env (no se sube a git) y completar.

# --- Backend ---
BACKEND_URL=https://fulltank-backend.onrender.com/api
DEVICE_TOKEN=
EDGE_API_KEY=

# --- Broker ---
# Público (por defecto):
MQTT_URL=tcp://broker.hivemq.com:1883
MQTT_USERNAME=
MQTT_PASSWORD=
# Plan B (Mosquitto local): MQTT_URL=tcp://mosquitto:1883 y MQTT_USERNAME/MQTT_PASSWORD = los de abajo.
# No pongas las credenciales de Mosquitto mientras uses el broker público: se las enviarías a un tercero.
MQTT_TOPIC=fulltank/cambia-este-sufijo/tanks/+/readings

# --- Mosquitto (plan B) ---
MOSQUITTO_USERNAME=fulltank
MOSQUITTO_PASSWORD=

# --- Política ---
ALLOWED_DEVICE_IDS=
MAX_LEVEL=100000
