@startuml
title <size:24>FullTank IAM bounded context</size>

set separator none
left to right direction
skinparam ranksep 60
skinparam nodesep 30
hide stereotype

<style>
  root {
    BackgroundColor: #ffffff;
    FontColor: #444444;
  }
  // Element
  .Element-RWxlbWVudA== {
    BackgroundColor: #ffffff;
    LineColor: #444444;
    LineStyle: 0;
    LineThickness: 2;
    FontColor: #444444;
    FontSize: 24;
    HorizontalAlignment: center;
    Shadowing: 0;
    MaximumWidth: 450;
  }
  // Relationship
  .Relationship-UmVsYXRpb25zaGlw {
    LineThickness: 2;
    LineStyle: 10-10;
    LineColor: #444444;
    FontColor: #444444;
    FontSize: 24;
  }
  // FullTank Platform
  .Boundary-RnVsbFRhbmsgUGxhdGZvcm0= {
    BackgroundColor: #ffffff;
    LineColor: #444444;
    LineStyle: 0;
    LineThickness: 2;
    FontColor: #444444;
    FontSize: 24;
    HorizontalAlignment: center;
    Shadowing: 0;
  }
</style>

rectangle "==Mobile / Web Client\n<size:16>[Person]</size>\n\nConsumes the public and protected REST API." <<Element-RWxlbWVudA==>> as MobileWebClient
rectangle "==Platform Administrator\n<size:16>[Person]</size>\n\nManages users and directory data." <<Element-RWxlbWVudA==>> as PlatformAdministrator
rectangle "==SMTP Provider\n<size:16>[Software System]</size>\n\nDelivers password reset messages." <<Element-RWxlbWVudA==>> as SMTPProvider

rectangle "FullTank Platform\n<size:16>[Software System]</size>" <<Boundary-RnVsbFRhbmsgUGxhdGZvcm0=>> {
  rectangle "==IAM Database\n<size:16>[Container: MySQL]</size>\n\nUsers, roles, companies and reset token hashes" <<Element-RWxlbWVudA==>> as FullTankPlatform.IAMDatabase
  rectangle "==Ordering\n<size:16>[Container: Spring Boot]</size>\n\nFuel requests and orders" <<Element-RWxlbWVudA==>> as FullTankPlatform.Ordering
  rectangle "==Inventory\n<size:16>[Container: Spring Boot]</size>\n\nFuel products and equipment" <<Element-RWxlbWVudA==>> as FullTankPlatform.Inventory
  rectangle "==Fulfillment\n<size:16>[Container: Spring Boot]</size>\n\nDrivers, vehicles and deliveries" <<Element-RWxlbWVudA==>> as FullTankPlatform.Fulfillment
  rectangle "==Reporting\n<size:16>[Container: Spring Boot]</size>\n\nAnalytics queries" <<Element-RWxlbWVudA==>> as FullTankPlatform.Reporting
  rectangle "==IAM Bounded Context\n<size:16>[Container: Spring Boot / DDD]</size>\n\nIdentity, access, users and companies" <<Element-RWxlbWVudA==>> as FullTankPlatform.IAMBoundedContext
}

MobileWebClient --> FullTankPlatform.IAMBoundedContext <<Relationship-UmVsYXRpb25zaGlw>> : "Uses HTTPS/JSON"
PlatformAdministrator --> FullTankPlatform.IAMBoundedContext <<Relationship-UmVsYXRpb25zaGlw>> : "Uses protected HTTPS/JSON"
FullTankPlatform.IAMBoundedContext --> FullTankPlatform.IAMDatabase <<Relationship-UmVsYXRpb25zaGlw>> : "Reads/writes"
FullTankPlatform.IAMBoundedContext --> SMTPProvider <<Relationship-UmVsYXRpb25zaGlw>> : "Requests password reset delivery"
FullTankPlatform.IAMBoundedContext --> FullTankPlatform.Ordering <<Relationship-UmVsYXRpb25zaGlw>> : "Authorizes requests"
FullTankPlatform.IAMBoundedContext --> FullTankPlatform.Inventory <<Relationship-UmVsYXRpb25zaGlw>> : "Authorizes requests"
FullTankPlatform.IAMBoundedContext --> FullTankPlatform.Fulfillment <<Relationship-UmVsYXRpb25zaGlw>> : "Authorizes requests"
FullTankPlatform.IAMBoundedContext --> FullTankPlatform.Reporting <<Relationship-UmVsYXRpb25zaGlw>> : "Authorizes requests"

@enduml